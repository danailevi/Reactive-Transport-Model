SOLUTION_MASTER_SPECIES
    Urea Urea  0 CO(NH2)2 60.06

SOLUTION_SPECIES
    Urea = Urea
            log_k  0
            Vm  14.5
    Cl- + H+ = HCl
            log_k   0.7
            delta_h 0       kcal
            -gamma  0       0.06
    Cl- + Ca+2 = CaCl+
            log_k   0.3
            delta_h 0       kcal
            -gamma  0       0.06
    2Cl- + Ca+2 = CaCl2
            log_k   .66
            delta_h 0       kcal
            -gamma  0       0.06

RATES
Ureolysis
-START
10 rate = PARM(3)*soln_vol*PARM(1)*MOL("Urea")/(MOL("Urea")+PARM(2))
20 moles = rate * TIME
30 SAVE moles
-END

Calcite
-START
10 rate = PARM(3)*(PARM(1)+PARM(2)*act("H+"))*(1-10^SI("Calcite"))
20 moles = rate * TIME
30 SAVE moles
-END

SELECTED_OUTPUT
    -step true
    -soln true
    -pH true
    -tot Ca Urea Amm C
    -k Ureolysis Calcite
END

